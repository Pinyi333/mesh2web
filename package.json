{
  "name": "mesh2web-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Turn any 3D model into a lightweight, beautiful, embeddable web component.",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "build:site": "node scripts/build.js && node scripts/build-site.js",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.js",
    "assets": "node scripts/make-test-assets.js",
    "dev": "node scripts/build.js && node scripts/serve.js",
    "lint": "node scripts/lint.js"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "playwright-core": "^1.63.0",
    "vitest": "^5.0.3"
  }
}
